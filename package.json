{
  "name": "ens-wind-tunnel",
  "version": "0.6.2",
  "private": true,
  "description": "ENS wind tunnel acquisition and control desktop application",
  "author": "ENS Wind Tunnel Team",
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "probe:daq": "node scripts/probe-daq.cjs",
    "build": "pnpm typecheck && electron-vite build",
    "format": "prettier --write src tests *.ts *.mts *.json docs README.md",
    "format:check": "prettier --check src tests *.ts *.mts *.json docs README.md",
    "check": "pnpm typecheck && pnpm test && pnpm format:check",
    "package": "pnpm build && electron-builder --win --dir",
    "dist": "node scripts/build-installer.cjs"
  },
  "build": {
    "appId": "edu.ens.windtunnel",
    "productName": "ENS Wind Tunnel",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "artifactName": "ENS-Wind-Tunnel-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serialport": "13.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
